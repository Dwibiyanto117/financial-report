PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/finreport_db"
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_in_production"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
DEFAULT_CURRENCY="IDR"
# Batas upload import mutasi per 10 menit (default: 10)
IMPORT_RATE_LIMIT_MAX=10
# Batas commit import mutasi per 10 menit (default: 30)
IMPORT_COMMIT_RATE_LIMIT_MAX=30
# Batas dekompresi XLSX import mutasi (Zip Bomb Guard, default: 50MB & 2000 entri)
IMPORT_XLSX_MAX_DECOMPRESSED_BYTES=52428800
IMPORT_XLSX_MAX_ZIP_ENTRIES=2000
